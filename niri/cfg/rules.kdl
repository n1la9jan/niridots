  window-rule {
      geometry-corner-radius 0
      clip-to-geometry true
      default-column-width { proportion 1.0; }
  }

  window-rule {
    opacity 0.6
    background-effect {
      blur true 
      xray false
    }
  }


/* Enable blur on noctalia's window switcher and disable xray. */
  layer-rule {
      match namespace="noctalia-window-switcher"
      background-effect {
          blur true 
          xray false
      }
  }


  layer-rule {
    match namespace="^noctalia-wallpaper*"
    place-within-backdrop true
  }

  window-rule {
    match app-id=r#"^org\.gnome\."#
    draw-border-with-background false
  }

  // Floating Noctalia settings window.
  window-rule {
    match app-id="dev.noctalia.Noctalia"
    open-floating true
    default-column-width { fixed 960; }
    default-window-height { fixed 720; }
  }


  // if you use steam you will probably like these
  window-rule {
      match app-id="steam"
      exclude title=r#"^[Ss]team$"#
      open-floating true
  }

  window-rule {
    match app-id="steam" title=r#"^notificationtoasts_\d+_desktop$"#
    default-floating-position x=10 y=10 relative-to="bottom-right"
    open-focused false
  }

  layer-rule {
    match namespace="^noctalia-(bar-[^\"]+|notification|dock|panel|attached-panel|osd)$"
    background-effect {
      xray false
      // blur false
    }
  }

  window-rule {
      match app-id=r#"^gnome-calculator$"#
      match app-id=r#"^galculator$"#
      match app-id=r#"^blueman-manager$"#
      match app-id=r#"^org\.kde\.kwalletmanager$"#
      match app-id="Pinentry-gtk"
      match app-id=r#"^org\.gnome\.Nautilus$"#
      match app-id=r#"^steam$"#
      match app-id=r#"^xdg-desktop-portal$"#
      open-floating true
      opacity 1.0
  }

  window-rule {
      match app-id=r#"^org\.wezfurlong\.wezterm$"#
      match app-id="Alacritty"
      match app-id="ghostty"
      match app-id="com.mitchellh.ghostty"
      match app-id="google-chrome"
      match app-id="firefox"
      match app-id="kitty"
      match app-id="zed"
      match app-id="discord"
      match app-id="helium"
      match app-id="Hermes"
      match app-id="antigravity"
      match app-id="Chatgpt"
      match app-id="telegram"
      match app-id="silkite"
      match app-id="micup"
      match app-id="obsidian"
      match app-id=r#"^org.telegram.desktop$"#
      match app-id=r#"^dev.noctalia.Noctalia$"#
      match title="YouTube Music"
      draw-border-with-background false
  }
  window-rule {
    match app-id="helium"
    // match app-id="silkite"
    opacity 1.0
  }
